<li class="app-row row--between" data-backup-file="<%= backup.file %>">
  <span>
    <span class="mono"><%= backup.file %></span>
    <% if (backup.preRestore) { %><span class="badge badge--mono">Sicherheitskopie</span><% } %>
    <span class="hint">— <%= formatSize(backup.size) %>, <%= formatDate(backup.createdAt) %> <%= formatTime(backup.createdAt) %></span>
  </span>
  <span class="app-row">
    <a class="btn btn-text theme-secondary btn-sm" href="/admin/backups/<%= encodeURIComponent(backup.file) %>/download" download>Herunterladen</a>
    <button type="button" class="btn btn-outline theme-secondary btn-sm" data-backup-restore="<%= backup.file %>">Wiederherstellen</button>
    <button type="button" class="btn btn-text theme-danger btn-sm" data-backup-delete="<%= backup.file %>">Löschen</button>
  </span>
</li>
