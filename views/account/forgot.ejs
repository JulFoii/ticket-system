<!DOCTYPE html>
<html lang="de">
<head>
  <%- include('../partials/head', { title: 'Passwort vergessen' }) %>
  <meta name="robots" content="noindex">
</head>
<body>
<%- include('../partials/navbar', { page: 'support' }) %>

<main class="auth" id="main">
  <div class="auth__card">
    <div class="auth__head">
      <span class="auth__logo"><%- include('../partials/icon', { name: 'lock', size: 18 }) %></span>
      <div class="auth__intro">
        <h1 class="auth__title">Passwort vergessen</h1>
        <p class="auth__subtitle">Wir senden dir einen Link, mit dem du ein neues Passwort festlegen kannst.</p>
      </div>
    </div>

    <div class="card">
      <div class="card-body stack stack--sm">
        <% if (error) { %>
          <%- include('../partials/alert', { variant: 'danger', text: error }) %>
        <% } %>
        <form class="stack stack--sm" action="/account/forgot" method="POST">
          <div class="field">
            <label class="form-label" for="email">E-Mail-Adresse</label>
            <input class="form-control" type="email" id="email" name="email" autocomplete="email" required autofocus>
          </div>
          <button type="submit" class="btn btn-solid theme-primary w-100">Link anfordern</button>
        </form>
      </div>
    </div>

    <p class="auth__footer"><a href="/account/login">Zurück zur Anmeldung</a></p>
  </div>
</main>

<script src="<%= asset('/js/theme.js') %>" defer></script>
</body>
</html>
