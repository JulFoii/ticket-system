# Vorlage fuer die .env (lokal neben server.js bzw. im Betrieb neben
# docker-compose.yml). Kopieren nach .env, ausfuellen, Rechte einschraenken:
#   cp .env.example .env && chmod 600 .env
# Hier stehen nur Platzhalter — niemals echte Zugangsdaten committen.
# Details zu jeder Variable: README.md und OPERATIONS.md.

# --- Allgemein -----------------------------------------------------------------
# Anzeigename in Navigation, Seitentiteln, Mails und Authenticator-App
APP_NAME=Ticketsystem
PORT=3000
# Verzeichnis fuer Datenbank, Event-Log, Backups und Ticket-Anhaenge
# (leer = ./data). Im Docker-Container als Volume eingehaengt.
DATA_DIR=
# Im Betrieb "production" — aktiviert die strengen Konfigurationspruefungen
NODE_ENV=

# --- Oeffentliche Adresse und TLS -------------------------------------------
# Domain fuer den mitgelieferten Caddy (docker compose --profile tls up -d)
DOMAIN=support.example.com
# Basis fuer alle Links in Mails — in production https:// und kein localhost.
# Lokal z. B. http://localhost:3000
PUBLIC_URL=
# Anzahl Proxy-Hops vor der App (1 = Caddy/nginx davor). Pflicht in production,
# lokal ohne Proxy leer lassen.
TRUST_PROXY=

# --- Bootstrap-once (nur beim allerersten Start gelesen, danach gilt die DB) -
# Leer lassen = sicherer Zufallswert; das Admin-Passwort steht dann EINMALIG im Log
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=

# --- Betrieb -----------------------------------------------------------------
MIN_FREE_DISK_MB=1024
# Zufaelliger Wert, z. B.: openssl rand -hex 32 — dann nur noch mit Bearer-Token
METRICS_TOKEN=
# json (Default in production) oder pretty
LOG_FORMAT=
LOG_LEVEL=info
# Ab welchem Level Detailmeldungen der Module (Requests, Mails, Jobs) auch auf
# der Konsole erscheinen; im Event-Log (/admin/logs) stehen sie immer
LOG_CONSOLE_LEVEL=warn
SHUTDOWN_TIMEOUT_MS=30000
# Zeitzone fuer alle angezeigten Zeiten; gespeichert wird immer UTC.
# IANA-Name, z. B. Europe/Berlin oder UTC
APP_TIMEZONE=Europe/Berlin

# --- Loeschfristen in Tagen (0 = aus) ----------------------------------------
AUDIT_LOG_RETENTION_DAYS=90
UNVERIFIED_ACCOUNT_RETENTION_DAYS=30
CLOSED_TICKET_RETENTION_DAYS=0

# --- Mailversand (SMTP, optional) -------------------------------------------
# Ohne SMTP_HOST ist der Mailversand aus; neue Kundenkonten werden dann unter
# /admin/customers manuell freigeschaltet.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Anfangswert fuer Admin-Mails; mehrere Empfaenger und Ereignisse danach im
# Admin-Bereich unter "Einstellungen & E-Mail" konfigurieren.
TICKET_NOTIFY_EMAIL=
TICKET_ATTACHMENT_MAX_MB=10
# Summe der Anhaenge, die einer Ticket-Mail als echte Dateien beiliegen; was
# darueber liegt, steht nur als Name mit "(im Portal)" in der Mail. 0 = nie anhaengen.
MAIL_ATTACHMENT_MAX_MB=10

# --- Antworten per Mail (IMAP, optional) -------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=60
# Verarbeitete Mails in diesen Ordner verschieben (wird angelegt, falls er
# fehlt; manche Server verlangen "INBOX.Verarbeitet"). Leer = im Postfach
# lassen, nur als gelesen markieren.
IMAP_PROCESSED_MAILBOX=
SUPPORT_REPLY_TO=
# Neue Tickets per Mail (nicht nur Antworten): authserv-id des eigenen
# Mailservers im Header "Authentication-Results" (z. B. mx.example.com). Nur
# Mails verifizierter Konten mit dkim=pass/dmarc=pass unter genau dieser ID
# werden zu Tickets. Leer = nur Antworten auf bestehende Tickets.
IMAP_AUTHSERV_ID=
