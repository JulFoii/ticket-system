<!DOCTYPE html>
<html lang="de">
<head>
  <%- include('partials/head', { title: article.title, description: article.excerpt }) %>
  <% if (!article.published) { %><meta name="robots" content="noindex"><% } %>
</head>
<%# data-live-url: ein Umbenennen des Slugs fuehrt zu 404, dann hoert das Polling auf. %>
<body data-live-page data-live-url="/support/articles/<%= article.slug %>">
<a class="skip-link" href="#main">Zum Inhalt springen</a>
<%- include('partials/navbar', { page: 'support' }) %>

<main class="main" id="main">
  <div class="container container--narrow">
    <a class="back-link" href="/support"><%- include('partials/icon', { name: 'arrowLeft', size: 14 }) %> Hilfe</a>

    <div data-live-region="kb-article">
    <% if (!article.published) { %>
      <div class="mb-4"><%- include('partials/alert', { variant: 'info', text: 'Entwurf — nur für den Admin sichtbar.' }) %></div>
    <% } %>

    <article class="card">
      <div class="card-body">
        <header class="page-header">
          <% if (article.categoryName) { %><p class="eyebrow"><%= article.categoryName %></p><% } %>
          <h1 class="page-header__title"><%= article.title %></h1>
          <p class="page-header__meta"><span>Aktualisiert am <%= formatDate(article.updatedAt) %></span></p>
        </header>
        <%# html stammt aus lib/markdown.js renderMarkdown(): der Text wird dort vollstaendig escaped, bevor Tags entstehen %>
        <div class="prose"><%- html %></div>
      </div>
      <div class="card-footer">
        <% if (isAdmin) { %>
          <span class="hint">Vorschau als Administrator</span>
          <a class="btn btn-outline theme-secondary btn-sm" href="/admin/kb/<%= article.id %>"><%- include('partials/icon', { name: 'settings', size: 14 }) %> Bearbeiten</a>
        <% } else { %>
          <span class="hint">Hat das nicht geholfen?</span>
          <a class="btn btn-solid theme-primary btn-sm" href="/support/articles/<%= article.slug %>/ticket"><%- include('partials/icon', { name: 'plus', size: 14 }) %> Ticket anlegen</a>
        <% } %>
      </div>
    </article>

    <% if (!isAdmin) { %>
      <section class="card mt-4" aria-labelledby="feedback-heading">
        <div class="card-header"><h2 class="card-title" id="feedback-heading">War dieser Artikel hilfreich?</h2></div>
        <div class="card-body">
          <% if (feedbackSaved || alreadyRated) { %>
            <p class="hint">Danke für dein Feedback. Es hilft uns, die Wissensdatenbank gezielt zu verbessern.</p>
          <% } else { %>
            <form class="stack stack--sm" method="POST" action="/support/articles/<%= article.slug %>/feedback">
              <div class="app-row">
                <button class="btn btn-outline theme-secondary btn-sm" type="submit" name="helpful" value="yes">Ja, hilfreich</button>
                <button class="btn btn-outline theme-secondary btn-sm" type="submit" name="helpful" value="no">Nein, noch nicht</button>
              </div>
              <div class="field">
                <label class="form-label" for="kb-comment">Was können wir verbessern? <span class="text-muted">(optional)</span></label>
                <textarea class="form-control form-control-sm" id="kb-comment" name="comment" rows="2" maxlength="500"></textarea>
              </div>
            </form>
          <% } %>
        </div>
      </section>
    <% } %>

    <% if (related.length) { %>
      <section class="card mt-4" aria-labelledby="related-heading">
        <div class="card-header"><h2 class="card-title" id="related-heading">Ähnliche Artikel</h2></div>
        <div class="card-body">
          <ul class="kb-list">
            <% related.forEach(other => { %>
              <li class="kb-list__item"><a class="kb-list__link" href="/support/articles/<%= other.slug %>"><span class="kb-list__title"><%= other.title %></span></a></li>
            <% }); %>
          </ul>
        </div>
      </section>
    <% } %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

<script src="<%= asset('/js/live-regions.js') %>" defer></script>
<script src="<%= asset('/js/theme.js') %>" defer></script>
</body>
</html>
